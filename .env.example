# Copia este archivo como ".env" y rellena los valores.

# Token del bot (Discord Developer Portal -> tu app -> Bot -> Reset Token)
DISCORD_TOKEN=pega_aqui_tu_token

# Prefijo de los comandos (ej: !play, ?play, -play)
PREFIX=!

# Ruta a ffmpeg. Déjalo en "ffmpeg" si está en el PATH,
# o pon la ruta completa, ej: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=ffmpeg

# Minutos sin reproducir nada (o solo en el canal) antes de desconectarse
IDLE_MINUTES=5

# Volumen inicial (0-100)
DEFAULT_VOLUME=50

# true = todas las canciones suenan con la misma intensidad (filtro loudnorm de FFmpeg)
NORMALIZE_VOLUME=true

# (opcional) Solo si algún día dejan de funcionar los links de Spotify: app gratis en
# https://developer.spotify.com/dashboard -> Client ID y Client secret
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Copias de seguridad diarias de data/: cuántos días guardar y en qué carpeta
# (vacío = carpeta "backups" del bot; puede ser una de OneDrive o Google Drive)
BACKUP_DAYS=14
BACKUP_DIR=

# ---------- Personaje con IA (opcional) ----------
# Si lo dejas vacío, el bot funciona igual pero con textos fijos.
# La IA nunca bloquea la música: si se acaba el cupo gratis, la música sigue con textos fijos.

# Clave de Google Gemini (gratis): https://aistudio.google.com/apikey  -> "Create API key"
# NO la compartas ni la subas a GitHub.
GEMINI_API_KEY=

# Archivo del personaje, dentro de la carpeta del bot:
#  - .txt con la descripción (por defecto personajes/lillia.txt, puedes editarlo)
#  - .png o .json: "character card" descargada de chub.ai (el .png también pone el avatar)
PERSONA_FILE=personajes/lillia.txt

# (opcional) Archivo con frases de ejemplo. Por defecto: personajes/<nombre>_frases.txt si existe
PERSONA_EXAMPLES=

# (opcional) Nombre del personaje si no sale del archivo, e imagen para el avatar del bot
PERSONA_NAME=Lillia
PERSONA_AVATAR=

# Canales donde el personaje responde a TODOS los mensajes (IDs separados por coma).
# En el resto solo responde si lo mencionas, le respondes o usas el prefijo (ej: "!hola").
# Ojo: responder a todo gasta mucho cupo de la IA.
PERSONA_CHANNELS=

# Idioma en el que habla
PERSONA_LANGUAGE=español

# true = el personaje comenta la música (canción en cola, skip...). false = ahorra cupo de la IA
PERSONA_MUSIC_COMMENTS=true

# Curiosidades: probabilidad (0 a 1) de que el personaje comente algo de la canción que suena
# (dato del artista, la letra, la melodía...), y máximo de veces por día. 0 = desactivado.
PERSONA_TRIVIA_CHANCE=0.15
PERSONA_TRIVIA_PER_DAY=1

# true = se le puede pedir música hablándole normal ("@Lillia poneme Tik Tok de Kesha",
# "pon una canción que te guste", "sube el volumen"...). Solo cuando le hablan directamente.
PERSONA_MUSIC_CONTROL=true

# true = cuando le preguntan por builds, runas, counters o picks de League, trae los datos del parche
# actual (de OP.GG; si no responde, de la búsqueda en internet) antes de responder.
PERSONA_LOL_SEARCH=true
# true = cuando le hablan directamente y necesita un dato actual que no sabe (noticias, precios, horarios...),
# puede pedir una búsqueda en internet. Lo decide ella: en la charla normal no busca.
PERSONA_AUTO_SEARCH=true

# ---------- Búsqueda en internet y clima ----------
# Tavily (https://tavily.com): 1000 búsquedas por mes gratis. Con la clave, Lillia busca datos actuales
# (noticias, precios, fechas, resultados, notas de parche...).
TAVILY_API_KEY=
# Búsquedas por mes que se permite gastar (el plan gratis tiene 1000)
TAVILY_MONTHLY_LIMIT=1000
# Clima (Open-Meteo, gratis y sin clave): lugar que se usa si la pregunta no dice dónde, y país preferido
WEATHER_DEFAULT_PLACE=
WEATHER_COUNTRY=AR
# Builds, runas, counters y tier list desde OP.GG (gratis, sin clave). false = no usarlo
OPGG=true

# true = el bot usa el nombre (apodo) y el avatar del personaje
PERSONA_USE_PROFILE=true

# true = también responde por mensaje privado
PERSONA_ALLOW_DM=true

# Probabilidad (0 a 1) de reaccionar con un emoji (de los del servidor si hay alguno de flores,
# corazones, sueño...) cuando alguien nombra a Lillia sin hablarle. 0 = nunca. No gasta IA.
PERSONA_NAME_REACT=0.5

# ---------- Eventos (fechas especiales, parches, Wrapped, buenas noches) ----------
# Las fechas especiales se editan en personajes/eventos.json (el Mundial ya está cargado).
# Canal donde Lillia anuncia cosas sola (ID del canal; uno por servidor, separados por coma).
# Vacío = el último canal donde se usaron comandos del bot, o el canal de bienvenida del servidor.
PERSONA_EVENTS_CHANNEL=
# A partir de qué hora (de tu PC) hace los anuncios del día
PERSONA_EVENTS_HOUR=12
# true = anuncia los parches nuevos de League con un resumen de los cambios
PERSONA_PATCH_NEWS=true
# true = cada 2 semanas busca solo las fechas del MSI y de las finales de ligas (LCK, LPL, LEC, LCS,
# CBLOL, LCP) que no estén en eventos.json, y las anuncia el día que empiezan
PERSONA_ESPORTS_AUTO=true
# true = el día 1 de cada mes publica el Lillia Wrapped del servidor del mes que terminó
PERSONA_MONTHLY_WRAPPED=true
# true = saluda a los miembros nuevos (activa "Server Members Intent" en el Developer Portal -> Bot)
PERSONA_WELCOME=true
# true = si alguien escribe de madrugada, le dice buenas noches (una vez por noche y persona)
PERSONA_NIGHT_GREETING=true
# Horas de "madrugada" (desde-hasta, hora de tu PC; la hora final no se incluye)
PERSONA_NIGHT_HOURS=1-6

# ---------- League of Legends (Riot API) ----------
# Clave de https://developer.riotgames.com (tu app -> API key). NO la compartas.
RIOT_API_KEY=
# Servidor por defecto para !vincular: las, lan, br, na, euw... (las = Argentina/Chile/Uruguay...)
RIOT_PLATFORM=las
# true = cuando alguien con la cuenta vinculada termina una partida, Lillia publica un resumen
RIOT_POST_GAME=true
# true = además del comentario, muestra el cuadro con el resultado (KDA, súbditos, daño...)
RIOT_POST_GAME_DETAILS=false
# Cada cuántos minutos revisa si hay partidas nuevas (mínimo 2)
RIOT_POLL_MINUTES=4
# true = lee las partidas de ARAM: Caos (que Riot no comparte por su API) desde el cliente de League
# abierto en esta PC. Se conecta solo; si no encuentra el cliente, pon la ruta del archivo "lockfile"
# de la carpeta de League en LOL_LOCKFILE (ej: D:\Riot Games\League of Legends\lockfile)
LCU_MAYHEM=true
LOL_LOCKFILE=
# true = durante la selección de campeones, Lillia te manda por privado runas/aumentos, build y consejos
# para esa partida (lee el cliente de esta PC; se adapta al modo: Grieta, ARAM, ARAM: Caos, Arena...)
LCU_CHAMP_SELECT=true

# ---------- Bots ayudantes (música en varios canales de voz a la vez) ----------
# Tokens de otras aplicaciones de bot (Developer Portal -> tu app -> Bot -> Reset Token), separados por coma.
# Cada ayudante tiene que estar invitado al servidor (ver canales, conectar, hablar). Vacío = solo Lillia.
HELPER_TOKENS=

# ---------- Dados (D&D) ----------
# true = reacciona con un emoji a las tiradas de otros bots de dados y comenta los 20 y los 1 naturales
DICE_REACTIONS=true
# IDs de los bots de dados (clic derecho en el bot -> Copiar ID), separados por coma.
# Vacío = los reconoce por el nombre (D&D, dnd, dice, dado, roll...)
DICE_BOT_IDS=
# Probabilidad de que comente una tirada normal (0 = nunca, 1 = siempre)
DICE_COMMENT_CHANCE=0.15

# ---------- Avisos al dueño por mensaje privado ----------
# Te avisa por DM cuando la IA se queda sin cupo (y cuándo vuelve) y cuando yt-dlp falla 3 veces seguidas.
# OWNER_ID: tu ID de Discord (clic derecho en tu nombre -> Copiar ID de usuario). Vacío = el dueño
# de la aplicación en el Developer Portal.
OWNER_ID=
OWNER_ALERTS=true

# ---------- Avanzado ----------
# Modelos de Gemini a usar, en orden, separados por coma. Vacío = elige solo los mejores gratis.
GEMINI_MODEL=

# IA de respaldo para cuando Gemini se queda sin cupo (vacío = sin respaldo).
# Groq: https://console.groq.com -> API Keys (gratis, sin tarjeta). Sirve cualquier API compatible con OpenAI.
BACKUP_AI_KEY=
BACKUP_AI_URL=https://api.groq.com/openai/v1
BACKUP_AI_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
